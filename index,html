/* =========================================================
   TOAST
========================================================= */

function showToast(message){

    const wrapper =
        document.getElementById(
            "toastWrapper"
        );


    const toast =
        document.createElement(
            "div"
        );


    toast.className =
        "toast";


    toast.textContent =
        message;


    wrapper.appendChild(
        toast
    );


    setTimeout(
        function(){

            toast.style.opacity =
                "0";


            toast.style.transform =
                "translateY(8px)";


            toast.style.transition =
                "all .25s ease";


            setTimeout(
                function(){

                    toast.remove();

                },
                260
            );

        },
        2800
    );

}



