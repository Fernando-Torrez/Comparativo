<script>

/* =========================================================
   ELEMENTOS
========================================================= */

const previousInput =
    document.getElementById("previousInput");

const currentInput =
    document.getElementById("currentInput");

const previousCounter =
    document.getElementById("previousCounter");

const currentCounter =
    document.getElementById("currentCounter");

const resultsSection =
    document.getElementById("results");

const emptyState =
    document.getElementById("emptyState");

const tableBody =
    document.getElementById("tableBody");

const tableCount =
    document.getElementById("tableCount");

const searchInput =
    document.getElementById("searchInput");


let activeTab = "new";


let resultData = {

    previous:[],

    current:[],

    newCodes:[],

    removed:[],

    same:[],

    duplicates:[]

};



/* =========================================================
   PARSEAR CÓDIGOS
========================================================= */

function parseCodes(text){

    if(!text){
        return [];
    }

    return text

        .split(/[\n\r\t,;]+/)

        .map(function(code){

            return code.trim();

        })

        .filter(function(code){

            return code !== "";

        });

}



/* =========================================================
   ÚNICOS
========================================================= */

function uniqueCodes(codes){

    return Array.from(
        new Set(codes)
    );

}



/* =========================================================
   DUPLICADOS
========================================================= */

function findDuplicates(codes){

    const counter = new Map();


    codes.forEach(function(code){

        counter.set(

            code,

            (counter.get(code) || 0) + 1

        );

    });


    return Array.from(
        counter.entries()
    )

    .filter(function(entry){

        return entry[1] > 1;

    })

    .map(function(entry){

        return {

            code:entry[0],

            amount:entry[1]

        };

    });

}



/* =========================================================
   FORMATO
========================================================= */

function formatNumber(value){

    return new Intl.NumberFormat(
        "es-GT"
    ).format(value);

}



/* =========================================================
   CONTADORES INPUT
========================================================= */

function updateInputCounters(){

    previousCounter.textContent =
        formatNumber(
            parseCodes(
                previousInput.value
            ).length
        );


    currentCounter.textContent =
        formatNumber(
            parseCodes(
                currentInput.value
            ).length
        );

}



previousInput.addEventListener(
    "input",
    updateInputCounters
);


currentInput.addEventListener(
    "input",
    updateInputCounters
);



/* =========================================================
   COMPARAR
========================================================= */

function compare(){

    const previousRaw =
        parseCodes(
            previousInput.value
        );


    const currentRaw =
        parseCodes(
            currentInput.value
        );


    if(
        previousRaw.length === 0 &&
        currentRaw.length === 0
    ){

        showToast(
            "Ingrese los códigos antes de realizar la comparación."
        );

        return;

    }


    const previous =
        uniqueCodes(
            previousRaw
        );


    const current =
        uniqueCodes(
            currentRaw
        );


    const previousSet =
        new Set(previous);


    const currentSet =
        new Set(current);



    const newCodes =
        current.filter(function(code){

            return !previousSet.has(code);

        });



    const removed =
        previous.filter(function(code){

            return !currentSet.has(code);

        });



    const same =
        current.filter(function(code){

            return previousSet.has(code);

        });



    const previousDuplicates =
        findDuplicates(
            previousRaw
        ).map(function(item){

            return {

                code:item.code,

                amount:item.amount,

                period:"Asignación anterior"

            };

        });



    const currentDuplicates =
        findDuplicates(
            currentRaw
        ).map(function(item){

            return {

                code:item.code,

                amount:item.amount,

                period:"Asignación actual"

            };

        });



    resultData = {

        previous:previous,

        current:current,

        newCodes:newCodes,

        removed:removed,

        same:same,

        duplicates:
            previousDuplicates.concat(
                currentDuplicates
            )

    };


    updateDashboard();


    activeTab =
        "new";


    searchInput.value =
        "";


    updateTabs();

    renderTable();


    emptyState.style.display =
        "none";


    resultsSection.style.display =
        "block";


    resultsSection.scrollIntoView({

        behavior:"smooth",

        block:"start"

    });


    showToast(
        "Comparación realizada correctamente."
    );

}



/* =========================================================
   DASHBOARD
========================================================= */

function updateDashboard(){

    const previous =
        resultData.previous.length;

    const current =
        resultData.current.length;

    const newTotal =
        resultData.newCodes.length;

    const removed =
        resultData.removed.length;

    const same =
        resultData.same.length;


    animateNumber(
        "metricPrevious",
        previous
    );


    animateNumber(
        "metricCurrent",
        current
    );


    animateNumber(
        "metricNew",
        newTotal
    );


    animateNumber(
        "metricRemoved",
        removed
    );


    animateNumber(
        "metricSame",
        same
    );


    document.getElementById(
        "newTabCount"
    ).textContent =
        formatNumber(newTotal);


    document.getElementById(
        "removedTabCount"
    ).textContent =
        formatNumber(removed);


    document.getElementById(
        "sameTabCount"
    ).textContent =
        formatNumber(same);


    document.getElementById(
        "duplicatesTabCount"
    ).textContent =
        formatNumber(
            resultData.duplicates.length
        );



    /* PROGRESS */

    const maxValue =
        Math.max(

            current,

            newTotal,

            removed,

            same,

            1

        );


    setProgress(
        "barCurrent",
        "barCurrentNumber",
        current,
        maxValue
    );


    setProgress(
        "barNew",
        "barNewNumber",
        newTotal,
        maxValue
    );


    setProgress(
        "barRemoved",
        "barRemovedNumber",
        removed,
        maxValue
    );


    setProgress(
        "barSame",
        "barSameNumber",
        same,
        maxValue
    );



    /* VARIACIÓN */

    const difference =
        current - previous;


    let percentage = 0;


    if(previous > 0){

        percentage =
            (difference / previous) * 100;

    }
    else if(current > 0){

        percentage = 100;

    }


    const variationNumber =
        document.getElementById(
            "variationNumber"
        );


    variationNumber.textContent =

        difference > 0

        ? "+" + formatNumber(difference)

        : formatNumber(difference);



    document.getElementById(
        "variationPercent"
    ).textContent =

        (
            percentage > 0
            ? "+"
            : ""
        )

        +

        percentage.toLocaleString(
            "es-GT",
            {
                minimumFractionDigits:1,
                maximumFractionDigits:1
            }
        )

        +

        "% respecto al período anterior";



    const description =
        document.getElementById(
            "variationDescription"
        );


    if(difference > 0){

        description.textContent =
            "La asignación actual registra un incremento neto de códigos respecto al período anterior.";

    }
    else if(difference < 0){

        description.textContent =
            "La asignación actual presenta una disminución neta de códigos respecto al período anterior.";

    }
    else{

        description.textContent =
            "La cantidad total de códigos se mantiene sin variación entre ambos períodos.";

    }

}



/* =========================================================
   ANIMAR NÚMEROS
========================================================= */

function animateNumber(
    elementId,
    target
){

    const element =
        document.getElementById(
            elementId
        );


    const duration =
        650;


    const start =
        performance.now();


    function frame(time){

        const progress =
            Math.min(
                (time - start) /
                duration,
                1
            );


        const eased =
            1 -
            Math.pow(
                1 - progress,
                3
            );


        const value =
            Math.round(
                target * eased
            );


        element.textContent =
            formatNumber(value);


        if(progress < 1){

            requestAnimationFrame(
                frame
            );

        }

    }


    requestAnimationFrame(
        frame
    );

}



/* =========================================================
   PROGRESS
========================================================= */

function setProgress(
    barId,
    numberId,
    value,
    max
){

    document.getElementById(
        numberId
    ).textContent =
        formatNumber(value);


    const percentage =
        value === 0

        ? 0

        : Math.max(
            2,
            (value / max) * 100
        );


    const bar =
        document.getElementById(
            barId
        );


    bar.style.width =
        "0%";


    setTimeout(function(){

        bar.style.width =
            percentage + "%";

    },100);

}



/* =========================================================
   FILAS
========================================================= */

function getRows(){

    if(activeTab === "new"){

        return resultData.newCodes.map(
            function(code){

                return {

                    code:code,

                    status:"Nuevo",

                    badge:"badge-new"

                };

            }
        );

    }



    if(activeTab === "removed"){

        return resultData.removed.map(
            function(code){

                return {

                    code:code,

                    status:"Retirado",

                    badge:"badge-removed"

                };

            }
        );

    }



    if(activeTab === "same"){

        return resultData.same.map(
            function(code){

                return {

                    code:code,

                    status:"Se mantiene",

                    badge:"badge-same"

                };

            }
        );

    }



    if(activeTab === "duplicates"){

        return resultData.duplicates.map(
            function(item){

                return {

                    code:item.code,

                    status:
                        item.amount +
                        " veces · " +
                        item.period,

                    badge:
                        "badge-duplicate"

                };

            }
        );

    }



    return resultData.current.map(
        function(code){

            const isNew =
                resultData
                .newCodes
                .includes(code);


            return {

                code:code,

                status:
                    isNew
                    ? "Nuevo"
                    : "Se mantiene",

                badge:
                    isNew
                    ? "badge-new"
                    : "badge-same"

            };

        }
    );

}



/* =========================================================
   RENDER TABLE
========================================================= */

function renderTable(){

    let rows =
        getRows();


    const search =
        searchInput
        .value
        .trim()
        .toLowerCase();


    if(search){

        rows =
            rows.filter(
                function(row){

                    return row
                        .code
                        .toLowerCase()
                        .includes(search);

                }
            );

    }


    tableBody.innerHTML =
        "";


    if(rows.length === 0){

        const row =
            document.createElement(
                "tr"
            );


        const cell =
            document.createElement(
                "td"
            );


        cell.colSpan =
            3;


        cell.className =
            "empty-row";


        cell.textContent =
            "No se encontraron registros en esta categoría.";


        row.appendChild(
            cell
        );


        tableBody.appendChild(
            row
        );


        tableCount.textContent =
            "0 registros";


        return;

    }



    rows.forEach(
        function(item,index){

            const row =
                document.createElement(
                    "tr"
                );


            const numberCell =
                document.createElement(
                    "td"
                );


            numberCell.className =
                "row-number";


            numberCell.textContent =
                index + 1;



            const codeCell =
                document.createElement(
                    "td"
                );


            codeCell.className =
                "code";


            codeCell.textContent =
                item.code;



            const statusCell =
                document.createElement(
                    "td"
                );


            const badge =
                document.createElement(
                    "span"
                );


            badge.className =
                "status-badge " +
                item.badge;


            badge.textContent =
                item.status;


            statusCell.appendChild(
                badge
            );


            row.appendChild(
                numberCell
            );


            row.appendChild(
                codeCell
            );


            row.appendChild(
                statusCell
            );


            tableBody.appendChild(
                row
            );

        }
    );


    tableCount.textContent =

        formatNumber(
            rows.length
        )

        +

        (
            rows.length === 1
            ? " registro"
            : " registros"
        );

}



/* =========================================================
   TABS
========================================================= */

function updateTabs(){

    document
    .querySelectorAll(
        ".tab"
    )
    .forEach(
        function(tab){

            tab.classList.toggle(

                "active",

                tab.dataset.tab ===
                activeTab

            );

        }
    );

}



document
.querySelectorAll(
    ".tab"
)
.forEach(
    function(tab){

        tab.addEventListener(
            "click",
            function(){

                activeTab =
                    this.dataset.tab;


                searchInput.value =
                    "";


                updateTabs();

                renderTable();

            }
        );

    }
);



/* =========================================================
   SEARCH
========================================================= */

searchInput.addEventListener(
    "input",
    renderTable
);



/* =========================================================
   COPY
========================================================= */

document
.getElementById(
    "copyButton"
)
.addEventListener(
    "click",
    async function(){

        const rows =
            getFilteredRows();


        if(rows.length === 0){

            showToast(
                "No hay códigos para copiar."
            );

            return;

        }


        const text =
            rows
            .map(
                function(row){

                    return row.code;

                }
            )
            .join("\n");


        try{

            await navigator
            .clipboard
            .writeText(text);


            showToast(
                formatNumber(
                    rows.length
                ) +
                " códigos copiados."
            );

        }
        catch(error){

            const temp =
                document.createElement(
                    "textarea"
                );


            temp.value =
                text;


            document.body.appendChild(
                temp
            );


            temp.select();


            document.execCommand(
                "copy"
            );


            temp.remove();


            showToast(
                "Códigos copiados."
            );

        }

    }
);



/* =========================================================
   FILTRADOS
========================================================= */

function getFilteredRows(){

    let rows =
        getRows();


    const search =
        searchInput
        .value
        .trim()
        .toLowerCase();


    if(search){

        rows =
            rows.filter(
                function(row){

                    return row
                    .code
                    .toLowerCase()
                    .includes(search);

                }
            );

    }


    return rows;

}



/* =========================================================
   CSV
========================================================= */

document
.getElementById(
    "downloadButton"
)
.addEventListener(
    "click",
    function(){

        const rows =
            getFilteredRows();


        if(rows.length === 0){

            showToast(
                "No hay información para exportar."
            );

            return;

        }


        const data = [

            [
                "Codigo",
                "Estado"
            ],

            ...rows.map(
                function(row){

                    return [

                        row.code,

                        row.status

                    ];

                }
            )

        ];


        const csv =
            "\uFEFF"

            +

            data.map(
                function(row){

                    return row.map(
                        function(value){

                            return (
                                '"' +
                                String(value)
                                .replaceAll(
                                    '"',
                                    '""'
                                )
                                +
                                '"'
                            );

                        }
                    )
                    .join(";");

                }
            )
            .join("\n");


        const blob =
            new Blob(
                [csv],
                {
                    type:
                        "text/csv;charset=utf-8;"
                }
            );


        const url =
            URL.createObjectURL(
                blob
            );


        const link =
            document.createElement(
                "a"
            );


        const names = {

            new:
                "codigos_nuevos",

            removed:
                "codigos_retirados",

            same:
                "codigos_se_mantienen",

            duplicates:
                "codigos_duplicados",

            current:
                "asignacion_actual"

        };


        link.href =
            url;


        link.download =
            (
                names[activeTab]
                ||
                "comparacion"
            )
            +
            ".csv";


        document.body.appendChild(
            link
        );


        link.click();

        link.remove();


        URL.revokeObjectURL(
            url
        );


        showToast(
            "Archivo CSV generado correctamente."
        );

    }
);



