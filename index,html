<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#10233f">

<title>Control de Asignaciones</title>

<style>

/* =========================================================
   VARIABLES
========================================================= */

:root{
    --navy:#10233f;
    --navy-2:#18375d;
    --navy-3:#244d79;

    --gold:#b9965b;
    --gold-dark:#967440;
    --gold-soft:#f4ecdf;

    --ivory:#f7f4ee;
    --ivory-2:#f1ede5;

    --white:#ffffff;

    --text:#17243a;
    --muted:#748092;
    --muted-2:#9aa3af;

    --border:rgba(16,35,63,.10);

    --green:#2f7d62;
    --green-soft:#edf7f2;

    --red:#a94a4a;
    --red-soft:#fbefef;

    --purple:#6c5a87;
    --purple-soft:#f2eff6;

    --orange:#a96d3b;
    --orange-soft:#faf2e9;

    --shadow:
        0 24px 55px rgba(16,35,63,.08),
        0 3px 10px rgba(16,35,63,.04);

    --shadow-soft:
        0 12px 30px rgba(16,35,63,.06);

    --radius:22px;
    --radius-sm:14px;
}


/* =========================================================
   RESET
========================================================= */

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    min-height:100vh;

    font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;

    color:var(--text);

    background:
        radial-gradient(
            circle at 4% 10%,
            rgba(185,150,91,.10),
            transparent 25rem
        ),
        radial-gradient(
            circle at 92% 8%,
            rgba(16,35,63,.07),
            transparent 27rem
        ),
        var(--ivory);

    overflow-x:hidden;
}

button,
textarea,
input{
    font:inherit;
}

button{
    cursor:pointer;
}

::selection{
    color:white;
    background:var(--navy);
}


/* =========================================================
   DECORACIÓN DE FONDO
========================================================= */

.background-decoration{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:-1;
}

.blur-orb{
    position:absolute;
    border-radius:50%;
    filter:blur(1px);
}

.blur-orb.one{
    width:340px;
    height:340px;

    top:160px;
    right:-180px;

    background:
        radial-gradient(
            circle,
            rgba(185,150,91,.12),
            transparent 70%
        );
}

.blur-orb.two{
    width:400px;
    height:400px;

    bottom:-220px;
    left:-170px;

    background:
        radial-gradient(
            circle,
            rgba(24,55,93,.08),
            transparent 70%
        );
}


/* =========================================================
   HEADER
========================================================= */

.header{
    position:sticky;
    top:0;
    z-index:100;

    background:
        rgba(247,244,238,.88);

    backdrop-filter:
        blur(18px)
        saturate(130%);

    border-bottom:
        1px solid rgba(16,35,63,.07);
}

.header-inner{
    width:min(1440px, calc(100% - 48px));

    min-height:80px;

    margin:auto;

    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:24px;
}

.brand{
    display:flex;
    align-items:center;
    gap:14px;
}

.brand-emblem{
    width:46px;
    height:46px;

    display:grid;
    place-items:center;

    border-radius:50%;

    color:#f5e7cc;

    background:
        linear-gradient(
            145deg,
            var(--navy),
            #1d4169
        );

    box-shadow:
        0 9px 22px rgba(16,35,63,.18);
}

.brand-emblem svg{
    width:23px;
    height:23px;
}

.brand-title{
    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:18px;
    font-weight:600;

    letter-spacing:.01em;
}

.brand-subtitle{
    margin-top:3px;

    color:var(--muted);

    font-size:11px;

    letter-spacing:.08em;

    text-transform:uppercase;
}

.header-status{
    display:flex;
    align-items:center;

    gap:8px;

    padding:9px 13px;

    border:
        1px solid rgba(16,35,63,.09);

    border-radius:999px;

    color:var(--muted);

    background:
        rgba(255,255,255,.62);

    font-size:11px;
    font-weight:600;
}

.status-dot{
    width:7px;
    height:7px;

    border-radius:50%;

    background:var(--green);

    box-shadow:
        0 0 0 4px
        rgba(47,125,98,.10);
}


/* =========================================================
   MAIN
========================================================= */

main{
    width:min(1440px, calc(100% - 48px));

    margin:auto;

    padding:
        58px
        0
        70px;
}


/* =========================================================
   HERO
========================================================= */

.hero{
    display:grid;

    grid-template-columns:
        minmax(0,1.35fr)
        minmax(300px,.65fr);

    gap:50px;

    align-items:end;

    margin-bottom:42px;

    animation:
        fadeUp .8s ease both;
}

.hero-kicker{
    display:inline-flex;

    align-items:center;

    gap:10px;

    color:var(--gold-dark);

    font-size:11px;
    font-weight:750;

    text-transform:uppercase;

    letter-spacing:.18em;

    margin-bottom:16px;
}

.hero-kicker::before{
    content:"";

    display:block;

    width:28px;
    height:1px;

    background:var(--gold);
}

.hero h1{
    margin:0;

    max-width:780px;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-weight:500;

    font-size:
        clamp(36px,5vw,67px);

    line-height:1.02;

    letter-spacing:-.045em;

    color:var(--navy);
}

.hero h1 em{
    color:var(--gold-dark);

    font-style:italic;
}

.hero-description{
    margin:
        22px
        0
        0;

    max-width:710px;

    color:#667386;

    font-size:15px;

    line-height:1.8;
}

.hero-side{
    padding-bottom:6px;
}

.hero-side-line{
    width:100%;
    height:1px;

    background:
        linear-gradient(
            90deg,
            var(--gold),
            transparent
        );

    margin-bottom:20px;
}

.hero-side p{
    margin:0;

    color:var(--muted);

    line-height:1.75;

    font-family:
        Georgia,
        serif;

    font-size:14px;

    font-style:italic;
}


/* =========================================================
   INPUT CARDS
========================================================= */

.comparison-grid{
    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:22px;
}

.input-card{
    position:relative;

    padding:25px;

    background:
        rgba(255,255,255,.83);

    backdrop-filter:blur(10px);

    border:
        1px solid rgba(16,35,63,.08);

    border-radius:var(--radius);

    box-shadow:var(--shadow-soft);

    overflow:hidden;

    transition:
        transform .35s ease,
        box-shadow .35s ease,
        border-color .35s ease;

    animation:
        fadeUp .8s .12s ease both;
}

.input-card:nth-child(2){
    animation-delay:.20s;
}

.input-card::before{
    content:"";

    position:absolute;

    top:0;
    left:0;

    width:100%;
    height:3px;

    opacity:.8;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--gold),
            transparent
        );
}

.input-card:hover{
    transform:translateY(-3px);

    box-shadow:var(--shadow);

    border-color:
        rgba(185,150,91,.20);
}

.card-header{
    display:flex;

    justify-content:space-between;

    gap:18px;

    align-items:flex-start;

    margin-bottom:18px;
}

.card-heading{
    display:flex;

    align-items:center;

    gap:13px;
}

.card-number{
    width:39px;
    height:39px;

    display:grid;

    place-items:center;

    flex:0 0 auto;

    border-radius:12px;

    background:var(--navy);

    color:#f2dfbd;

    font-family:
        Georgia,
        serif;

    font-size:13px;
}

.card-label{
    font-family:
        Georgia,
        serif;

    font-size:17px;

    color:var(--navy);

    font-weight:600;
}

.card-description{
    margin-top:4px;

    color:var(--muted);

    font-size:11px;
}

.counter{
    flex:0 0 auto;

    padding:7px 11px;

    border-radius:10px;

    color:var(--navy);

    background:var(--gold-soft);

    font-size:11px;
    font-weight:700;
}

textarea{
    display:block;

    width:100%;
    min-height:285px;

    padding:18px 19px;

    resize:vertical;

    border:
        1px solid
        rgba(16,35,63,.10);

    border-radius:15px;

    outline:none;

    background:
        rgba(247,244,238,.68);

    color:var(--navy);

    font-family:
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        monospace;

    font-size:13px;

    line-height:1.7;

    transition:
        background .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}

textarea::placeholder{
    color:#a2a9b3;
}

textarea:focus{
    background:#fff;

    border-color:
        rgba(185,150,91,.70);

    box-shadow:
        0 0 0 4px
        rgba(185,150,91,.09);
}

.input-footer{
    display:flex;

    align-items:center;

    gap:8px;

    margin-top:12px;

    color:var(--muted-2);

    font-size:10.5px;
}

.input-footer svg{
    width:14px;
    height:14px;

    color:var(--gold-dark);
}


/* =========================================================
   ACCIONES
========================================================= */

.action-panel{
    margin:
        22px
        0
        34px;

    padding:13px;

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:14px;

    border:
        1px solid rgba(16,35,63,.08);

    border-radius:17px;

    background:
        rgba(255,255,255,.75);

    box-shadow:
        0 8px 25px rgba(16,35,63,.04);

    backdrop-filter:blur(12px);
}

.action-group{
    display:flex;

    align-items:center;

    flex-wrap:wrap;

    gap:9px;
}

.btn{
    min-height:43px;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:9px;

    padding:
        0
        17px;

    border-radius:11px;

    border:none;

    font-size:12px;

    font-weight:700;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        background .18s ease;
}

.btn svg{
    width:16px;
    height:16px;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-primary{
    color:white;

    background:
        linear-gradient(
            135deg,
            var(--navy),
            var(--navy-2)
        );

    box-shadow:
        0 9px 22px
        rgba(16,35,63,.18);
}

.btn-primary:hover{
    box-shadow:
        0 12px 28px
        rgba(16,35,63,.24);
}

.btn-outline{
    color:var(--navy);

    background:
        rgba(255,255,255,.8);

    border:
        1px solid
        rgba(16,35,63,.10);
}

.btn-outline:hover{
    background:#fff;
}

.btn-gold{
    color:#73562e;

    background:var(--gold-soft);
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-state{
    position:relative;

    overflow:hidden;

    min-height:220px;

    display:grid;

    place-items:center;

    padding:45px;

    text-align:center;

    border:
        1px dashed
        rgba(16,35,63,.18);

    border-radius:var(--radius);

    background:
        rgba(255,255,255,.48);
}

.empty-state::before{
    content:"";

    position:absolute;

    width:260px;
    height:260px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            rgba(185,150,91,.08),
            transparent 70%
        );
}

.empty-content{
    position:relative;
    z-index:2;
}

.empty-icon{
    width:54px;
    height:54px;

    margin:
        0
        auto
        15px;

    display:grid;

    place-items:center;

    border-radius:50%;

    color:var(--gold-dark);

    background:var(--gold-soft);
}

.empty-icon svg{
    width:24px;
    height:24px;
}

.empty-state strong{
    display:block;

    font-family:
        Georgia,
        serif;

    color:var(--navy);

    font-size:17px;

    margin-bottom:7px;
}

.empty-state span{
    color:var(--muted);

    font-size:12px;
}


/* =========================================================
   RESULTS
========================================================= */

#results{
    display:none;

    animation:
        fadeUp .6s ease both;
}

.results-heading{
    display:flex;

    justify-content:space-between;

    align-items:flex-end;

    gap:20px;

    margin-bottom:17px;
}

.results-heading small{
    display:block;

    color:var(--gold-dark);

    text-transform:uppercase;

    letter-spacing:.15em;

    font-size:10px;

    font-weight:750;

    margin-bottom:7px;
}

.results-heading h2{
    margin:0;

    font-family:
        Georgia,
        serif;

    color:var(--navy);

    font-weight:500;

    font-size:29px;
}

.results-heading p{
    margin:
        6px
        0
        0;

    color:var(--muted);

    font-size:12px;
}


/* =========================================================
   METRICS
========================================================= */

.metrics{
    display:grid;

    grid-template-columns:
        repeat(5,minmax(0,1fr));

    gap:14px;

    margin-bottom:20px;
}

.metric-card{
    position:relative;

    min-height:145px;

    padding:19px;

    overflow:hidden;

    border:
        1px solid rgba(16,35,63,.08);

    border-radius:18px;

    background:
        rgba(255,255,255,.87);

    box-shadow:
        0 7px 20px rgba(16,35,63,.035);

    transition:
        transform .25s ease,
        box-shadow .25s ease;
}

.metric-card:hover{
    transform:translateY(-4px);

    box-shadow:var(--shadow-soft);
}

.metric-card::after{
    content:"";

    position:absolute;

    width:85px;
    height:85px;

    right:-30px;
    top:-30px;

    border-radius:50%;

    background:currentColor;

    opacity:.045;
}

.metric-top{
    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-bottom:16px;
}

.metric-label{
    color:var(--muted);

    font-size:9.5px;

    text-transform:uppercase;

    letter-spacing:.10em;

    font-weight:800;
}

.metric-icon{
    width:30px;
    height:30px;

    display:grid;
    place-items:center;

    border-radius:9px;
}

.metric-icon svg{
    width:15px;
    height:15px;
}

.metric-value{
    font-family:
        Georgia,
        serif;

    font-size:34px;

    line-height:1;

    letter-spacing:-.03em;
}

.metric-note{
    margin-top:9px;

    color:var(--muted-2);

    font-size:10.5px;
}


/* colores */

.metric-previous{
    color:var(--navy);
}

.metric-previous .metric-icon{
    background:#edf1f5;
}

.metric-current{
    color:var(--navy-3);
}

.metric-current .metric-icon{
    background:#eef4fa;
}

.metric-new{
    color:var(--green);
}

.metric-new .metric-icon{
    background:var(--green-soft);
}

.metric-removed{
    color:var(--red);
}

.metric-removed .metric-icon{
    background:var(--red-soft);
}

.metric-same{
    color:var(--purple);
}

.metric-same .metric-icon{
    background:var(--purple-soft);
}


/* =========================================================
   SUMMARY
========================================================= */

.summary-grid{
    display:grid;

    grid-template-columns:
        minmax(0,1.45fr)
        minmax(310px,.55fr);

    gap:18px;

    margin-bottom:20px;
}

.summary-card{
    padding:24px;

    border:
        1px solid rgba(16,35,63,.08);

    border-radius:20px;

    background:
        rgba(255,255,255,.85);

    box-shadow:
        0 7px 22px
        rgba(16,35,63,.035);
}

.summary-title{
    font-family:
        Georgia,
        serif;

    color:var(--navy);

    font-size:16px;

    margin-bottom:4px;
}

.summary-subtitle{
    color:var(--muted);

    font-size:11px;

    margin-bottom:24px;
}

.progress-item{
    margin-bottom:18px;
}

.progress-item:last-child{
    margin-bottom:0;
}

.progress-header{
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    margin-bottom:8px;

    color:var(--muted);

    font-size:11px;
}

.progress-header strong{
    color:var(--text);
}

.progress-track{
    height:7px;

    overflow:hidden;

    border-radius:999px;

    background:#edf0f2;
}

.progress-fill{
    width:0;

    height:100%;

    border-radius:999px;

    transition:
        width
        .9s
        cubic-bezier(.22,.61,.36,1);
}

.progress-current{
    background:var(--navy-3);
}

.progress-new{
    background:var(--green);
}

.progress-removed{
    background:var(--red);
}

.progress-same{
    background:var(--purple);
}


/* Variation */

.variation-card{
    min-height:280px;

    display:flex;

    flex-direction:column;

    justify-content:center;

    position:relative;

    overflow:hidden;

    color:white;

    background:
        linear-gradient(
            145deg,
            #10233f,
            #1c4069
        );
}

.variation-card::before{
    content:"";

    position:absolute;

    width:230px;
    height:230px;

    border:
        1px solid
        rgba(255,255,255,.08);

    border-radius:50%;

    right:-100px;
    top:-105px;
}

.variation-card::after{
    content:"";

    position:absolute;

    width:150px;
    height:150px;

    border:
        1px solid
        rgba(185,150,91,.18);

    border-radius:50%;

    right:-60px;
    top:-65px;
}

.variation-eyebrow{
    position:relative;
    z-index:2;

    color:#d5c19c;

    font-size:9.5px;

    text-transform:uppercase;

    letter-spacing:.13em;

    font-weight:800;
}

.variation-number{
    position:relative;
    z-index:2;

    margin:
        11px
        0
        4px;

    font-family:
        Georgia,
        serif;

    font-size:50px;

    line-height:1;
}

.variation-percent{
    position:relative;
    z-index:2;

    color:#e1d3bb;

    font-size:12px;

    font-weight:600;
}

.variation-description{
    position:relative;
    z-index:2;

    max-width:285px;

    margin-top:20px;

    color:#cbd4df;

    line-height:1.65;

    font-size:11px;
}


/* =========================================================
   RESULT TABLE
========================================================= */

.list-card{
    overflow:hidden;

    border:
        1px solid rgba(16,35,63,.08);

    border-radius:20px;

    background:
        rgba(255,255,255,.90);

    box-shadow:
        0 8px 25px
        rgba(16,35,63,.04);
}

.list-toolbar{
    min-height:69px;

    padding:
        14px
        17px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    border-bottom:
        1px solid rgba(16,35,63,.07);
}

.tabs{
    display:flex;

    flex-wrap:wrap;

    gap:6px;
}

.tab{
    min-height:35px;

    padding:
        0
        11px;

    border:none;

    border-radius:9px;

    color:var(--muted);

    background:transparent;

    font-size:10.5px;

    font-weight:750;

    transition:all .2s ease;
}

.tab:hover{
    color:var(--navy);

    background:
        rgba(16,35,63,.045);
}

.tab.active{
    color:var(--navy);

    background:var(--gold-soft);

    box-shadow:
        inset 0 0 0 1px
        rgba(185,150,91,.12);
}

.tab span{
    margin-left:4px;

    opacity:.72;
}

.toolbar-actions{
    display:flex;

    align-items:center;

    gap:8px;
}

.search-wrapper{
    position:relative;
}

.search-wrapper svg{
    position:absolute;

    left:11px;
    top:50%;

    width:14px;
    height:14px;

    transform:translateY(-50%);

    color:var(--muted-2);

    pointer-events:none;
}

.search{
    width:215px;
    height:37px;

    padding:
        0
        12px
        0
        33px;

    outline:none;

    border:
        1px solid rgba(16,35,63,.10);

    border-radius:9px;

    color:var(--navy);

    background:#faf9f6;

    font-size:11px;

    transition:.2s ease;
}

.search:focus{
    border-color:
        rgba(185,150,91,.65);

    background:white;

    box-shadow:
        0 0 0 3px
        rgba(185,150,91,.08);
}

.icon-button{
    width:37px;
    height:37px;

    display:grid;

    place-items:center;

    padding:0;

    border:
        1px solid rgba(16,35,63,.10);

    border-radius:9px;

    color:var(--muted);

    background:white;

    transition:all .2s ease;
}

.icon-button:hover{
    color:var(--navy);

    border-color:
        rgba(185,150,91,.40);

    background:var(--gold-soft);

    transform:translateY(-1px);
}

.icon-button svg{
    width:15px;
    height:15px;
}


