<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Comparador profesional de códigos entre mes actual y mes anterior." />
  <title>Comparador de Asignaciones</title>

  <style>
    :root {
      --bg: #f5f7fb;
      --surface: #ffffff;
      --surface-soft: #f8fafc;
      --border: #e5eaf1;

      --text: #18212f;
      --text-soft: #667085;
      --text-light: #98a2b3;

      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --primary-soft: #eff6ff;

      --green: #16a34a;
      --green-soft: #ecfdf3;

      --red: #dc2626;
      --red-soft: #fef2f2;

      --amber: #d97706;
      --amber-soft: #fffbeb;

      --purple: #7c3aed;
      --purple-soft: #f5f3ff;

      --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.04);
      --shadow-md: 0 12px 30px rgba(15, 23, 42, 0.07);
      --radius: 18px;
      --radius-sm: 12px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(37, 99, 235, 0.05), transparent 28rem),
        var(--bg);
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      min-height: 100vh;
    }

    /* HEADER */

    .topbar {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(229, 234, 241, 0.9);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-inner {
      max-width: 1440px;
      margin: 0 auto;
      min-height: 72px;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      color: white;
      background: linear-gradient(135deg, #2563eb, #4f46e5);
      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.22);
    }

    .brand-icon svg {
      width: 22px;
      height: 22px;
    }

    .brand-title {
      font-weight: 800;
      letter-spacing: -0.025em;
      font-size: 17px;
    }

    .brand-subtitle {
      color: var(--text-soft);
      font-size: 12px;
      margin-top: 2px;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-soft);
      font-size: 12px;
      font-weight: 600;
      padding: 8px 11px;
      background: var(--surface-soft);
      border: 1px solid var(--border);
      border-radius: 999px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.1);
    }

    /* MAIN */

    main {
      max-width: 1440px;
      margin: 0 auto;
      padding: 34px 24px 60px;
    }

    .hero {
      margin-bottom: 28px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 10px;
    }

    h1 {
      font-size: clamp(28px, 4vw, 42px);
      margin: 0;
      line-height: 1.05;
      letter-spacing: -0.045em;
    }

    .hero p {
      max-width: 720px;
      margin: 14px 0 0;
      color: var(--text-soft);
      line-height: 1.65;
      font-size: 15px;
    }

    /* INPUT AREA */

    .comparison-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }

    .input-card {
      padding: 22px;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 16px;
    }

    .card-title-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .card-number {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 13px;
    }

    .previous .card-number {
      color: var(--purple);
      background: var(--purple-soft);
    }

    .current .card-number {
      color: var(--primary);
      background: var(--primary-soft);
    }

    .card-title {
      font-weight: 800;
      font-size: 15px;
    }

    .card-description {
      font-size: 12px;
      color: var(--text-soft);
      margin-top: 3px;
    }

    .counter {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-soft);
      white-space: nowrap;
      background: var(--surface-soft);
      border: 1px solid var(--border);
      padding: 7px 10px;
      border-radius: 8px;
    }

    textarea {
      width: 100%;
      min-height: 260px;
      resize: vertical;
      border: 1px solid var(--border);
      outline: none;
      border-radius: 13px;
      background: var(--surface-soft);
      padding: 16px;
      color: var(--text);
      line-height: 1.65;
      font-family:
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        monospace;
      font-size: 13px;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    textarea:focus {
      background: white;
      border-color: rgba(37, 99, 235, 0.55);
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
    }

    textarea::placeholder {
      color: #a3adbd;
    }

    .helper {
      margin-top: 11px;
      color: var(--text-light);
      font-size: 11px;
      line-height: 1.5;
    }

    /* ACTIONS */

    .actions {
      margin: 22px 0 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      padding: 15px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      box-shadow: var(--shadow-sm);
    }

    .actions-left,
    .actions-right {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn {
      border: 0;
      padding: 11px 16px;
      border-radius: 10px;
      font-weight: 750;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition:
        transform 0.15s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    .btn svg {
      width: 17px;
      height: 17px;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      color: white;
      background: linear-gradient(135deg, var(--primary), #4f46e5);
      box-shadow: 0 8px 18px rgba(37, 99, 235, 0.2);
    }

    .btn-primary:hover {
      box-shadow: 0 10px 24px rgba(37, 99, 235, 0.27);
    }

    .btn-secondary {
      color: var(--text);
      background: white;
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background: var(--surface-soft);
    }

    /* EMPTY */

    .empty-results {
      background: white;
      border: 1px dashed #cbd5e1;
      padding: 46px 20px;
      text-align: center;
      border-radius: var(--radius);
      color: var(--text-soft);
    }

    .empty-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 14px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      background: var(--primary-soft);
      color: var(--primary);
    }

    .empty-icon svg {
      width: 25px;
      height: 25px;
    }

    .empty-results strong {
      display: block;
      color: var(--text);
      margin-bottom: 6px;
      font-size: 15px;
    }

    /* RESULTS */

    #resultsSection {
      display: none;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      margin: 0 0 15px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 20px;
      letter-spacing: -0.025em;
    }

    .section-heading p {
      margin: 5px 0 0;
      color: var(--text-soft);
      font-size: 12px;
    }

    .metrics {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 22px;
    }

    .metric {
      padding: 18px;
      min-height: 124px;
      position: relative;
      overflow: hidden;
    }

    .metric::after {
      content: "";
      position: absolute;
      width: 70px;
      height: 70px;
      border-radius: 50%;
      right: -24px;
      top: -24px;
      opacity: 0.08;
      background: currentColor;
    }

    .metric-label {
      color: var(--text-soft);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .metric-value {
      font-size: 30px;
      line-height: 1;
      font-weight: 850;
      letter-spacing: -0.04em;
      margin-bottom: 10px;
    }

    .metric-note {
      color: var(--text-soft);
      font-size: 11px;
    }

    .metric.current-total .metric-value {
      color: var(--primary);
    }

    .metric.new-total .metric-value {
      color: var(--green);
    }

    .metric.removed-total .metric-value {
      color: var(--red);
    }

    .metric.equal-total .metric-value {
      color: var(--purple);
    }

    .metric.duplicate-total .metric-value {
      color: var(--amber);
    }

    /* VISUAL SUMMARY */

    .summary-grid {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 18px;
      margin-bottom: 22px;
    }

    .summary-card {
      padding: 22px;
    }

    .summary-title {
      font-weight: 800;
      font-size: 14px;
      margin-bottom: 5px;
    }

    .summary-subtitle {
      color: var(--text-soft);
      font-size: 11px;
      margin-bottom: 22px;
    }

    .bar-group {
      margin-bottom: 17px;
    }

    .bar-group:last-child {
      margin-bottom: 0;
    }

    .bar-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 7px;
      font-size: 11px;
    }

    .bar-label {
      font-weight: 700;
      color: var(--text-soft);
    }

    .bar-number {
      font-weight: 800;
    }

    .bar-track {
      height: 8px;
      background: #eef2f6;
      border-radius: 999px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: inherit;
      width: 0;
      transition: width 0.7s cubic-bezier(.22,.61,.36,1);
    }

    .bar-current {
      background: var(--primary);
    }

    .bar-new {
      background: var(--green);
    }

    .bar-removed {
      background: var(--red);
    }

    .bar-equal {
      background: var(--purple);
    }

    .change-box {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .change-big {
      font-size: 44px;
      font-weight: 850;
      letter-spacing: -0.05em;
      line-height: 1;
      margin: 4px 0 9px;
    }

    .change-positive {
      color: var(--green);
    }

    .change-negative {
      color: var(--red);
    }

    .change-neutral {
      color: var(--text-soft);
    }

    .change-description {
      color: var(--text-soft);
      font-size: 12px;
      line-height: 1.5;
    }

    /* RESULT TABLE */

    .result-card {
      overflow: hidden;
    }

    .result-toolbar {
      padding: 17px 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    .tabs {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .tab {
      border: 1px solid transparent;
      background: transparent;
      padding: 8px 11px;
      border-radius: 9px;
      color: var(--text-soft);
      font-weight: 750;
      font-size: 11px;
      transition: 0.2s ease;
    }

    .tab:hover {
      background: var(--surface-soft);
    }

    .tab.active {
      color: var(--primary);
      background: var(--primary-soft);
      border-color: #dbeafe;
    }

    .tab-count {
      margin-left: 5px;
      opacity: 0.7;
    }

    .toolbar-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .search-wrap {
      position: relative;
    }

    .search-wrap svg {
      position: absolute;
      width: 15px;
      height: 15px;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-light);
      pointer-events: none;
    }

    .search {
      height: 36px;
      width: 220px;
      border-radius: 9px;
      border: 1px solid var(--border);
      outline: none;
      padding: 0 12px 0 34px;
      font-size: 12px;
      background: var(--surface-soft);
    }

    .search:focus {
      border-color: rgba(37, 99, 235, 0.45);
      background: white;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.07);
    }

    .small-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      display: grid;
      place-items: center;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: white;
      color: var(--text-soft);
      transition: 0.2s ease;
    }

    .small-btn:hover {
      color: var(--primary);
      background: var(--primary-soft);
      border-color: #dbeafe;
    }

    .small-btn svg {
      width: 16px;
      height: 16px;
    }

    .table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    thead {
      background: #fafbfc;
    }

    th,
    td {
      padding: 13px 18px;
      text-align: left;
      border-bottom: 1px solid #eef1f5;
    }

    th {
      color: var(--text-soft);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 10px;
      font-weight: 800;
      white-space: nowrap;
    }

    tbody tr {
      transition: background 0.15s ease;
    }

    tbody tr:hover {
      background: #fafcff;
    }

    tbody tr:last-child td {
      border-bottom: 0;
    }

    .index-cell {
      width: 60px;
      color: var(--text-light);
      font-variant-numeric: tabular-nums;
    }

    .code-cell {
      font-family:
        "SFMono-Regular",
        Consolas,
        monospace;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 8px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 800;
      white-space: nowrap;
    }

    .badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .badge-new {
      background: var(--green-soft);
      color: var(--green);
    }

    .badge-new::before {
      background: var(--green);
    }

    .badge-removed {
      background: var(--red-soft);
      color: var(--red);
    }

    .badge-removed::before {
      background: var(--red);
    }

    .badge-equal {
      background: var(--purple-soft);
      color: var(--purple);
    }

    .badge-equal::before {
      background: var(--purple);
    }

    .badge-duplicate {
      background: var(--amber-soft);
      color: var(--amber);
    }

    .badge-duplicate::before {
      background: var(--amber);
    }

    .empty-table {
      padding: 45px 20px !important;
      text-align: center;
      color: var(--text-soft);
    }

    .table-footer {
      padding: 12px 18px;
      border-top: 1px solid var(--border);
      color: var(--text-soft);
      font-size: 11px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* TOAST */

    .toast-container {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 9px;
      pointer-events: none;
    }

    .toast {
      min-width: 260px;
      max-width: 360px;
      padding: 13px 15px;
      border-radius: 11px;
      background: #111827;
      color: white;
      box-shadow: 0 14px 35px rgba(15, 23, 42, 0.22);
      font-size: 12px;
      font-weight: 650;
      animation: toastIn 0.25s ease;
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* FOOTER */

    footer {
      margin-top: 34px;
      color: var(--text-light);
      text-align: center;
      font-size: 11px;
      line-height: 1.6;
    }

    /* RESPONSIVE */

    @media (max-width: 1100px) {
      .metrics {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 860px) {
      .comparison-grid {
        grid-template-columns: 1fr;
      }

      .summary-grid {
        grid-template-columns: 1fr;
      }

      .metrics {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 620px) {
      main {
        padding: 25px 14px 45px;
      }

      .topbar-inner {
        padding: 0 14px;
      }

      .status {
        display: none;
      }

      .brand-subtitle {
        display: none;
      }

      .input-card {
        padding: 16px;
      }

      textarea {
        min-height: 210px;
      }

      .metrics {
        grid-template-columns: 1fr 1fr;
      }

      .metric {
        min-height: 110px;
        padding: 15px;
      }

      .metric-value {
        font-size: 25px;
      }

      .actions {
        align-items: stretch;
      }

      .actions-left,
      .actions-right {
        width: 100%;
      }

      .actions-left .btn,
      .actions-right .btn {
        flex: 1;
      }

      .result-toolbar {
        align-items: stretch;
      }

      .toolbar-actions,
      .search-wrap {
        width: 100%;
      }

      .search {
        width: 100%;
      }

      .tabs {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <div class="app">

    <!-- HEADER -->
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">
          <div class="brand-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 5h16M4 12h10M4 19h7" stroke-linecap="round"/>
              <path d="m16 17 2 2 4-5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div>
            <div class="brand-title">Comparador de Asignaciones</div>
            <div class="brand-subtitle">Control y validación mensual de códigos</div>
          </div>
        </div>

        <div class="status">
          <span class="status-dot"></span>
          Procesamiento local y seguro
        </div>
      </div>
    </header>

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="eyebrow">Herramienta de comparación</div>
        <h1>Compara tus asignaciones<br>en segundos.</h1>
        <p>
          Pega los códigos del mes anterior y del mes actual.
          El sistema identificará automáticamente altas, bajas,
          coincidencias y registros duplicados.
        </p>
      </section>

      <!-- INPUTS -->
      <section class="comparison-grid">

        <article class="card input-card previous">
          <div class="card-header">
            <div class="card-title-area">
              <div class="card-number">01</div>
              <div>
                <div class="card-title">Asignación anterior</div>
                <div class="card-description">Listado base para realizar la comparación</div>
              </div>
            </div>

            <div class="counter">
              <span id="previousCounter">0</span> códigos
            </div>
          </div>

          <textarea
            id="previousInput"
            spellcheck="false"
            placeholder="Pega aquí los códigos del mes anterior...

Ejemplo:
100001
100002
100003
100004"></textarea>

          <div class="helper">
            Puedes copiar directamente una columna desde Excel.
          </div>
        </article>

        <article class="card input-card current">
          <div class="card-header">
            <div class="card-title-area">
              <div class="card-number">02</div>
              <div>
                <div class="card-title">Asignación actual</div>
                <div class="card-description">Listado correspondiente al nuevo mes</div>
              </div>
            </div>

            <div class="counter">
              <span id="currentCounter">0</span> códigos
            </div>
          </div>

          <textarea
            id="currentInput"
            spellcheck="false"
            placeholder="Pega aquí los códigos del mes actual...

Ejemplo:
100001
100002
100005
100006"></textarea>

          <div class="helper">
            Se ignorarán espacios y líneas vacías automáticamente.
          </div>
        </article>

      </section>

      <!-- ACTIONS -->
      <section class="actions">
        <div class="actions-left">

          <button id="compareBtn" class="btn btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 7h11l-3-3m3 3-3 3M16 17H5l3 3m-3-3 3-3"
                    stroke-linecap="round"
                    stroke-linejoin="round"/>
            </svg>
            Comparar asignaciones
          </button>

          <button id="sampleBtn" class="btn btn-secondary">
            Cargar ejemplo
          </button>

        </div>

        <div class="actions-right">
          <button id="clearBtn" class="btn btn-secondary">
            Limpiar
          </button>
        </div>
      </section>

      <!-- EMPTY -->
      <section id="emptyState" class="empty-results">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/>
            <path d="M14 3v6h6"/>
            <path d="M8 13h8M8 17h5" stroke-linecap="round"/>
          </svg>
        </div>

        <strong>Aún no hay una comparación</strong>
        Pega tus listados y presiona “Comparar asignaciones”.
      </section>

      <!-- RESULTS -->
      <section id="resultsSection">

        <div class="section-heading">
          <div>
            <h2>Resumen de comparación</h2>
            <p>Resultados calculados a partir de los códigos únicos.</p>
          </div>
        </div>

        <!-- METRICS -->
        <div class="metrics">

          <article class="card metric current-total">
            <div class="metric-label">Mes actual</div>
            <div id="metricCurrent" class="metric-value">0</div>
            <div class="metric-note">Códigos únicos</div>
          </article>

          <article class="card metric new-total">
            <div class="metric-label">Nuevos</div>
            <div id="metricNew" class="metric-value">0</div>
            <div class="metric-note">No estaban anteriormente</div>
          </article>

          <article class="card metric removed-total">
            <div class="metric-label">Eliminados</div>
            <div id="metricRemoved" class="metric-value">0</div>
            <div class="metric-note">Ya no aparecen</div>
          </article>

          <article class="card metric equal-total">
            <div class="metric-label">Continúan</div>
            <div id="metricSame" class="metric-value">0</div>
            <div class="metric-note">Presentes en ambos meses</div>
          </article>

          <article class="card metric duplicate-total">
            <div class="metric-label">Duplicados</div>
            <div id="metricDuplicates" class="metric-value">0</div>
            <div class="metric-note">Detectados en ambos listados</div>
          </article>

        </div>

        <!-- SUMMARY -->
        <div class="summary-grid">

          <article class="card summary-card">
            <div class="summary-title">Distribución de resultados</div>
            <div class="summary-subtitle">
              Comparativa visual de los registros encontrados.
            </div>

            <div class="bar-group">
              <div class="bar-top">
                <span class="bar-label">Mes actual</span>
                <span id="barCurrentNumber" class="bar-number">0</span>
              </div>
              <div class="bar-track">
                <div id="barCurrent" class="bar-fill bar-current"></div>
              </div>
            </div>

            <div class="bar-group">
              <div class="bar-top">
                <span class="bar-label">Nuevos</span>
                <span id="barNewNumber" class="bar-number">0</span>
              </div>
              <div class="bar-track">
                <div id="barNew" class="bar-fill bar-new"></div>
              </div>
            </div>

            <div class="bar-group">
              <div class="bar-top">
                <span class="bar-label">Eliminados</span>
                <span id="barRemovedNumber" class="bar-number">0</span>
              </div>
              <div class="bar-track">
                <div id="barRemoved" class="bar-fill bar-removed"></div>
              </div>
            </div>

            <div class="bar-group">
              <div class="bar-top">
                <span class="bar-label">Continúan</span>
                <span id="barSameNumber" class="bar-number">0</span>
              </div>
              <div class="bar-track">
                <div id="barSame" class="bar-fill bar-equal"></div>
              </div>
            </div>
          </article>

          <article class="card summary-card">
            <div class="change-box">
              <div class="metric-label">Variación neta</div>
              <div id="changeValue" class="change-big change-neutral">0</div>
              <div id="changePercent" class="summary-title">0%</div>
              <div id="changeDescription" class="change-description">
                Sin cambios entre ambos períodos.
              </div>
            </div>
          </article>

        </div>

        <!-- RESULT LIST -->
        <article class="card result-card">

          <div class="result-toolbar">
            <div class="tabs">
              <button class="tab active" data-tab="new">
                Nuevos
                <span id="tabNewCount" class="tab-count">0</span>
              </button>

              <button class="tab" data-tab="removed">
                Eliminados
                <span id="tabRemovedCount" class="tab-count">0</span>
              </button>

              <button class="tab" data-tab="same">
                Continúan
                <span id="tabSameCount" class="tab-count">0</span>
              </button>

              <button class="tab" data-tab="duplicates">
                Duplicados
                <span id="tabDuplicatesCount" class="tab-count">0</span>
              </button>

              <button class="tab" data-tab="all">
                Todos actuales
                <span id="tabAllCount" class="tab-count">0</span>
              </button>
            </div>

            <div class="toolbar-actions">

              <div class="search-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="7"/>
                  <path d="m20 20-3.5-3.5" stroke-linecap="round"/>
                </svg>

                <input
                  id="searchInput"
                  class="search"
                  type="text"
                  placeholder="Buscar código..."
                />
              </div>

              <button id="copyBtn" class="small-btn" title="Copiar códigos">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="11" height="11" rx="2"/>
                  <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/>
                </svg>
              </button>

              <button id="downloadBtn" class="small-btn" title="Descargar CSV">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 3v12"/>
                  <path d="m7 10 5 5 5-5"/>
                  <path d="M5 21h14"/>
                </svg>
              </button>

            </div>
          </div>

          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Código</th>
                  <th>Estado</th>
                </tr>
              </thead>

              <tbody id="resultBody"></tbody>
            </table>
          </div>

          <div class="table-footer">
            <span id="resultCount">0 registros</span>
            <span>Comparación realizada localmente en tu navegador</span>
          </div>

        </article>
      </section>

      <footer>
        Comparador de asignaciones · Los datos ingresados no salen de tu navegador.
      </footer>

    </main>

    <div id="toastContainer" class="toast-container"></div>

  </div>

  <script>
    /* =========================================================
       COMPARADOR DE ASIGNACIONES
       Todo funciona localmente en el navegador.
    ========================================================== */

    const previousInput = document.getElementById("previousInput");
    const currentInput = document.getElementById("currentInput");

    const previousCounter = document.getElementById("previousCounter");
    const currentCounter = document.getElementById("currentCounter");

    const compareBtn = document.getElementById("compareBtn");
    const clearBtn = document.getElementById("clearBtn");
    const sampleBtn = document.getElementById("sampleBtn");

    const emptyState = document.getElementById("emptyState");
    const resultsSection = document.getElementById("resultsSection");

    const searchInput = document.getElementById("searchInput");
    const resultBody = document.getElementById("resultBody");
    const resultCount = document.getElementById("resultCount");

    const copyBtn = document.getElementById("copyBtn");
    const downloadBtn = document.getElementById("downloadBtn");

    let activeTab = "new";

    let results = {
      previous: [],
      current: [],
      new: [],
      removed: [],
      same: [],
      duplicates: []
    };

    /* =========================================================
       UTILIDADES
    ========================================================== */

    function parseCodes(text) {
      if (!text) return [];

      return text
        .split(/[\n\r,;\t]+/)
        .map(code => code.trim())
        .filter(Boolean);
    }

    function unique(array) {
      return [...new Set(array)];
    }

    function findDuplicates(array) {
      const count = new Map();

      array.forEach(item => {
        count.set(item, (count.get(item) || 0) + 1);
      });

      return [...count.entries()]
        .filter(([, amount]) => amount > 1)
        .map(([code, amount]) => ({
          code,
          amount
        }));
    }

    function escapeHTML(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function formatNumber(value) {
      return new Intl.NumberFormat("es-GT").format(value);
    }

    function updateCounters() {
      previousCounter.textContent = formatNumber(
        parseCodes(previousInput.value).length
      );

      currentCounter.textContent = formatNumber(
        parseCodes(currentInput.value).length
      );
    }

    /* =========================================================
       COMPARACIÓN
    ========================================================== */

    function compareLists() {
      const previousRaw = parseCodes(previousInput.value);
      const currentRaw = parseCodes(currentInput.value);

      if (!previousRaw.length && !currentRaw.length) {
        toast("Ingresa al menos un listado para realizar la comparación.");
        return;
      }

      const previous = unique(previousRaw);
      const current = unique(currentRaw);

      const previousSet = new Set(previous);
      const currentSet = new Set(current);

      const newCodes = current.filter(code => !previousSet.has(code));
      const removedCodes = previous.filter(code => !currentSet.has(code));
      const sameCodes = current.filter(code => previousSet.has(code));

      const previousDuplicates = findDuplicates(previousRaw).map(item => ({
        ...item,
        source: "Anterior"
      }));

      const currentDuplicates = findDuplicates(currentRaw).map(item => ({
        ...item,
        source: "Actual"
      }));

      results = {
        previous,
        current,
        new: newCodes,
        removed: removedCodes,
        same: sameCodes,
        duplicates: [
          ...previousDuplicates,
          ...currentDuplicates
        ]
      };

      updateDashboard();

      activeTab = "new";
      updateTabs();

      searchInput.value = "";
      renderTable();

      emptyState.style.display = "none";
      resultsSection.style.display = "block";

      resultsSection.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

      toast("Comparación realizada correctamente.");
    }

    /* =========================================================
       DASHBOARD
    ========================================================== */

    function updateDashboard() {
      const currentTotal = results.current.length;
      const previousTotal = results.previous.length;

      const newTotal = results.new.length;
      const removedTotal = results.removed.length;
      const sameTotal = results.same.length;
      const duplicateTotal = results.duplicates.length;

      document.getElementById("metricCurrent").textContent =
        formatNumber(currentTotal);

      document.getElementById("metricNew").textContent =
        formatNumber(newTotal);

      document.getElementById("metricRemoved").textContent =
        formatNumber(removedTotal);

      document.getElementById("metricSame").textContent =
        formatNumber(sameTotal);

      document.getElementById("metricDuplicates").textContent =
        formatNumber(duplicateTotal);

      document.getElementById("tabNewCount").textContent =
        formatNumber(newTotal);

      document.getElementById("tabRemovedCount").textContent =
        formatNumber(removedTotal);

      document.getElementById("tabSameCount").textContent =
        formatNumber(sameTotal);

      document.getElementById("tabDuplicatesCount").textContent =
        formatNumber(duplicateTotal);

      document.getElementById("tabAllCount").textContent =
        formatNumber(currentTotal);

      /* BARRAS */

      const max = Math.max(
        currentTotal,
        newTotal,
        removedTotal,
        sameTotal,
        1
      );

      setBar(
        "barCurrent",
        "barCurrentNumber",
        currentTotal,
        max
      );

      setBar(
        "barNew",
        "barNewNumber",
        newTotal,
        max
      );

      setBar(
        "barRemoved",
        "barRemovedNumber",
        removedTotal,
        max
      );

      setBar(
        "barSame",
        "barSameNumber",
        sameTotal,
        max
      );

      /* VARIACIÓN */

      const difference = currentTotal - previousTotal;

      const percentage =
        previousTotal === 0
          ? currentTotal > 0
            ? 100
            : 0
          : (difference / previousTotal) * 100;

      const changeValue = document.getElementById("changeValue");
      const changePercent = document.getElementById("changePercent");
      const changeDescription = document.getElementById("changeDescription");

      changeValue.className = "change-big";

      if (difference > 0) {
        changeValue.textContent = "+" + formatNumber(difference);
        changeValue.classList.add("change-positive");

        changeDescription.textContent =
          "La asignación actual contiene más códigos únicos que el período anterior.";
      }
      else if (difference < 0) {
        changeValue.textContent = formatNumber(difference);
        changeValue.classList.add("change-negative");

        changeDescription.textContent =
          "La asignación actual contiene menos códigos únicos que el período anterior.";
      }
      else {
        changeValue.textContent = "0";
        changeValue.classList.add("change-neutral");

        changeDescription.textContent =
          "La cantidad total de códigos únicos se mantiene sin cambios.";
      }

      const formattedPercent =
        Math.abs(percentage).toLocaleString("es-GT", {
          minimumFractionDigits: 1,
          maximumFractionDigits: 1
        });

      changePercent.textContent =
        (percentage > 0 ? "+" : percentage < 0 ? "-" : "") +
        formattedPercent +
        "% respecto al período anterior";
    }

    function setBar(barId, labelId, value, max) {
      document.getElementById(labelId).textContent =
        formatNumber(value);

      const percent = Math.max(
        value > 0 ? 3 : 0,
        (value / max) * 100
      );

      requestAnimationFrame(() => {
        document.getElementById(barId).style.width =
          percent + "%";
      });
    }

    /* =========================================================
       TABS Y TABLA
    ========================================================== */

    document.querySelectorAll(".tab").forEach(button => {
      button.addEventListener("click", () => {
        activeTab = button.dataset.tab;
        searchInput.value = "";

        updateTabs();
        renderTable();
      });
    });

    function updateTabs() {
      document.querySelectorAll(".tab").forEach(button => {
        button.classList.toggle(
          "active",
          button.dataset.tab === activeTab
        );
      });
    }

    function getActiveRows() {
      switch (activeTab) {

        case "new":
          return results.new.map(code => ({
            code,
            status: "Nuevo",
            type: "new"
          }));

        case "removed":
          return results.removed.map(code => ({
            code,
            status: "Eliminado",
            type: "removed"
          }));

        case "same":
          return results.same.map(code => ({
            code,
            status: "Continúa",
            type: "same"
          }));

        case "duplicates":
          return results.duplicates.map(item => ({
            code: item.code,
            status:
              `Duplicado ${item.amount} veces · ${item.source}`,
            type: "duplicate"
          }));

        case "all":
          return results.current.map(code => ({
            code,
            status: results.new.includes(code)
              ? "Nuevo"
              : "Continúa",
            type: results.new.includes(code)
              ? "new"
              : "same"
          }));

        default:
          return [];
      }
    }

    function renderTable() {
      const search = searchInput.value
        .trim()
        .toLowerCase();

      let rows = getActiveRows();

      if (search) {
        rows = rows.filter(item =>
          item.code.toLowerCase().includes(search)
        );
      }

      if (!rows.length) {
        resultBody.innerHTML = `
          <tr>
            <td colspan="3" class="empty-table">
              No se encontraron registros para esta vista.
            </td>
          </tr>
        `;

        resultCount.textContent = "0 registros";
        return;
      }

      resultBody.innerHTML = rows
        .map((item, index) => `
          <tr>
            <td class="index-cell">${index + 1}</td>

            <td class="code-cell">
              ${escapeHTML(item.code)}
            </td>

            <td>
              <span class="badge badge-${item.type}">
                ${escapeHTML(item.status)}
              </span>
            </td>
          </tr>
        `)
        .join("");

      resultCount.textContent =
        `${formatNumber(rows.length)} ${
          rows.length === 1 ? "registro" : "registros"
        }`;
    }

    /* =========================================================
       BUSCADOR
    ========================================================== */

    searchInput.addEventListener("input", renderTable);

    /* =========================================================
       COPIAR
    ========================================================== */

    copyBtn.addEventListener("click", async () => {
      const rows = getFilteredActiveRows();

      if (!rows.length) {
        toast("No hay códigos para copiar.");
        return;
      }

      const text = rows
        .map(item => item.code)
        .join("\n");

      try {
        await navigator.clipboard.writeText(text);
        toast(`${rows.length} códigos copiados al portapapeles.`);
      }
      catch {
        fallbackCopy(text);
      }
    });

    function getFilteredActiveRows() {
      const search = searchInput.value
        .trim()
        .toLowerCase();

      const rows = getActiveRows();

      if (!search) return rows;

      return rows.filter(item =>
        item.code.toLowerCase().includes(search)
      );
    }

    function fallbackCopy(text) {
      const area = document.createElement("textarea");

      area.value = text;
      area.style.position = "fixed";
      area.style.opacity = "0";

      document.body.appendChild(area);

      area.select();
      document.execCommand("copy");

      area.remove();

      toast("Códigos copiados al portapapeles.");
    }

    /* =========================================================
       CSV
    ========================================================== */

    downloadBtn.addEventListener("click", () => {
      const rows = getFilteredActiveRows();

      if (!rows.length) {
        toast("No hay registros para descargar.");
        return;
      }

      const csvRows = [
        ["Codigo", "Estado"],
        ...rows.map(item => [
          item.code,
          item.status
        ])
      ];

      const csv =
        "\uFEFF" +
        csvRows
          .map(row =>
            row
              .map(value =>
                `"${String(value).replaceAll('"', '""')}"`
              )
              .join(";")
          )
          .join("\n");

      const blob = new Blob(
        [csv],
        {
          type: "text/csv;charset=utf-8;"
        }
      );

      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");

      const fileNames = {
        new: "codigos_nuevos",
        removed: "codigos_eliminados",
        same: "codigos_continuan",
        duplicates: "codigos_duplicados",
        all: "asignacion_actual"
      };

      link.href = url;
      link.download =
        `${fileNames[activeTab] || "comparacion"}.csv`;

      document.body.appendChild(link);
      link.click();
      link.remove();

      URL.revokeObjectURL(url);

      toast("Archivo CSV generado correctamente.");
    });

    /* =========================================================
       LIMPIAR
    ========================================================== */

    clearBtn.addEventListener("click", () => {
      previousInput.value = "";
      currentInput.value = "";

      results = {
        previous: [],
        current: [],
        new: [],
        removed: [],
        same: [],
        duplicates: []
      };

      updateCounters();

      resultsSection.style.display = "none";
      emptyState.style.display = "block";

      searchInput.value = "";

      previousInput.focus();

      toast("Datos limpiados.");
    });

    /* =========================================================
       EJEMPLO
    ========================================================== */

    sampleBtn.addEventListener("click", () => {
      previousInput.value = [
        "100001",
        "100002",
        "100003",
        "100004",
        "100005",
        "100006",
        "100007",
        "100007",
        "100008",
        "100009"
      ].join("\n");

      currentInput.value = [
        "100001",
        "100002",
        "100003",
        "100005",
        "100006",
        "100008",
        "100009",
        "100010",
        "100011",
        "100012",
        "100012"
      ].join("\n");

      updateCounters();
      compareLists();
    });

    /* =========================================================
       EVENTOS
    ========================================================== */

    previousInput.addEventListener(
      "input",
      updateCounters
    );

    currentInput.addEventListener(
      "input",
      updateCounters
    );

    compareBtn.addEventListener(
      "click",
      compareLists
    );

    document.addEventListener("keydown", event => {
      if (
        (event.ctrlKey || event.metaKey) &&
        event.key === "Enter"
      ) {
        compareLists();
      }
    });

    /* =========================================================
       TOASTS
    ========================================================== */

    function toast(message) {
      const container =
        document.getElementById("toastContainer");

      const element =
        document.createElement("div");

      element.className = "toast";
      element.textContent = message;

      container.appendChild(element);

      setTimeout(() => {
        element.style.opacity = "0";
        element.style.transform =
          "translateY(8px)";

        element.style.transition =
          "all .2s ease";

        setTimeout(() => {
          element.remove();
        }, 220);

      }, 2800);
    }

    /* =========================================================
       INICIO
    ========================================================== */

    updateCounters();
  </script>
</body>
